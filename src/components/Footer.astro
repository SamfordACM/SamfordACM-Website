---
import { path } from '../lib/url';
import { SOCIALS } from '../lib/chapter';

const year = new Date().getFullYear();

// Add or remove links here; empty entries simply don't render.
const links = SOCIALS;
---

<footer class="border-t border-rule">
  <div class="mx-auto flex max-w-5xl flex-wrap gap-4 px-6 py-8 text-sm text-subtle sm:px-10">
    <p class="mr-auto">&copy; {year} Samford ACM</p>
    <div class="flex gap-6">
      {links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-ink">{l.label}</a>
      ))}
      <a href={path('/contact')} class="transition-colors hover:text-ink">Contact</a>
    </div>
  </div>
</footer>
