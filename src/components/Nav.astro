---
import { path, normalize } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/officers', label: 'Officers' },
  { href: '/join', label: 'Join' },
  { href: '/contact', label: 'Contact' },
];

const current = normalize(Astro.url.pathname);
---

<header class="border-b border-rule">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-baseline gap-x-7 gap-y-2 px-6 py-6 sm:px-10">
    <a
      href={path('/')}
      class="mr-auto font-display text-xl font-semibold tracking-tight text-ink"
    >Samford <span class="text-brand">ACM</span></a>

    {links.map(({ href, label }) => (
      <a
        href={path(href)}
        aria-current={current === href ? 'page' : undefined}
        class:list={[
          'text-sm transition-colors hover:text-ink',
          current === href
            ? 'border-b-2 border-brand pb-0.5 text-ink'
            : 'text-muted',
        ]}
      >{label}</a>
    ))}
  </nav>
</header>
