---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="border-b border-rule pb-8">
  <h1 class="font-display text-5xl font-normal tracking-tight">{title}</h1>
  {lead && <p class="mt-4 max-w-[36em] text-lg leading-relaxed text-body">{lead}</p>}
</header>
