---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { AREAS, ADVISOR } from '../lib/chapter';

// What a member actually gets, in the order a prospective member cares about.
const offers = [
  {
    title: 'A team',
    body: 'Hackathons and competitions are far better with people beside you. Teams form here, so you never have to enter one alone.',
  },
  {
    title: 'People to learn from',
    body: 'Someone to look at your code, answer the question you have been embarrassed to ask, and tell you what they wish they had known a year earlier.',
  },
  {
    title: 'Workshops',
    body: 'Practical sessions on the tooling coursework assumes you already know, and on what you can now build with AI.',
  },
  {
    title: 'Connections',
    body: 'Introductions to internships and to people doing this work already — the part that is hardest to arrange on your own.',
  },
];
---

<Base title="About">
  <PageHeader
    title="About"
    lead="ACM is the computing club at Samford — open to every student, whatever you are studying."
  />

  <div class="mt-12 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="max-w-[34em] space-y-5 text-lg leading-relaxed text-body">
        <p>
          We are the Samford chapter of the Association for Computing Machinery,
          and we are the only club on campus for anything computer-related. We
          are not run by the computer science department, and you do not need to
          be a computer science major to be here. Anyone at Samford can join.
        </p>
        <p>
          This year we are running events consistently — at least every other
          week — and putting real effort into reaching people who have never
          thought of themselves as technical. Hackathons, workshops, competitions,
          and visits to companies like Shipt to see the work up close.
        </p>
        <p>
          Computing is the rare skill that compounds on top of whatever else you
          know. It is worth having whether you intend to write software for a
          living or never write another line after graduation, and the distance
          between having an idea and actually building it has never been shorter
          than it is now.
        </p>
        <p>
          Samford is a Christian university, and that shapes how we want this
          chapter to run. We want it to be a place where people are genuinely
          looked after, where the newest member is treated as well as the most
          experienced one, and where what we build and how we treat each other
          both reflect Christ.
        </p>
      </div>
    </div>

    <aside class="lg:col-span-5 lg:border-l lg:border-rule lg:pl-10">
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">
        At a glance
      </h2>
      <dl class="mt-5 space-y-4 text-[15px]">
        <div class="flex gap-4 border-b border-rule pb-4">
          <dt class="w-28 shrink-0 text-subtle">Dues</dt>
          <dd>None — membership is free</dd>
        </div>
        <div class="flex gap-4 border-b border-rule pb-4">
          <dt class="w-28 shrink-0 text-subtle">Open to</dt>
          <dd>All Samford students, any major</dd>
        </div>
        <div class="flex gap-4 border-b border-rule pb-4">
          <dt class="w-28 shrink-0 text-subtle">Events</dt>
          <dd>At least every other week this year</dd>
        </div>
        <div class="flex gap-4">
          <dt class="w-28 shrink-0 text-subtle">Adviser</dt>
          <dd>{ADVISOR}</dd>
        </div>
      </dl>

      <h2 class="mt-10 text-xs font-semibold uppercase tracking-[0.14em] text-brand">
        What lives here
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {AREAS.map((area) => (
          <li class="border border-rule px-3 py-1.5 text-sm text-muted">{area}</li>
        ))}
      </ul>
    </aside>
  </div>

  <h2 class="mt-16 font-display text-3xl font-normal tracking-tight">What you get</h2>
  <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {offers.map((item) => (
      <div>
        <h3 class="font-display text-xl font-medium">{item.title}</h3>
        <p class="mt-2 leading-relaxed text-muted">{item.body}</p>
      </div>
    ))}
  </div>
</Base>
