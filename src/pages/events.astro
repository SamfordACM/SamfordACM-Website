---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const now = new Date();
const all = await getCollection('events');
const upcoming = all
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const past = all
  .filter((e) => e.data.date < now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit',
});
---

<Base title="Events">
  <h1 class="text-4xl font-bold tracking-tight">Events</h1>

  <h2 class="mt-10 text-2xl font-semibold tracking-tight">Upcoming</h2>
  {upcoming.length === 0 ? (
    <p class="mt-4 text-neutral-600">Nothing on the calendar yet.</p>
  ) : (
    <ul class="mt-4 space-y-4">
      {upcoming.map((event) => (
        <li class="rounded border border-neutral-200 p-5">
          <h3 class="text-lg font-medium">{event.data.title}</h3>
          <p class="mt-1 text-sm text-neutral-600">
            {dateFmt.format(event.data.date)} &middot; {event.data.location}
          </p>
          {event.data.rsvp && (
            <p class="mt-3">
              <a href={event.data.rsvp} class="text-brand-600 hover:underline">RSVP &rarr;</a>
            </p>
          )}
        </li>
      ))}
    </ul>
  )}

  {past.length > 0 && (
    <>
      <h2 class="mt-12 text-2xl font-semibold tracking-tight">Past</h2>
      <ul class="mt-4 space-y-2 text-neutral-600">
        {past.map((event) => (
          <li class="text-sm">
            <span class="text-neutral-900">{event.data.title}</span>
            {' '}&middot; {dateFmt.format(event.data.date)}
          </li>
        ))}
      </ul>
    </>
  )}
</Base>
