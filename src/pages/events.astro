---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { groupEvents, fmt, describeWhen } from '../lib/events';

const { upcoming, planned, past } = await groupEvents();
---

<Base title="Events">
  <PageHeader
    title="Events"
    lead="We are setting this year's schedule now. Everything below is confirmed to happen — dates go up here as soon as they are locked in."
  />

  {upcoming.length > 0 && (
    <>
      <h2 class="mt-12 font-display text-3xl font-normal tracking-tight">Scheduled</h2>
      <ul class="mt-6">
        {upcoming.map((event) => (
          <li class="flex flex-wrap items-baseline gap-x-8 gap-y-2 border-t border-rule py-7 last:border-b">
            <div class="w-20 shrink-0">
              <div class="text-xs uppercase tracking-[0.09em] text-subtle">
                {fmt.month(event.data.date!)}
              </div>
              <div class="font-display text-3xl leading-none">
                {fmt.day(event.data.date!)}
              </div>
            </div>
            <div class="grow">
              <h3 class="font-display text-2xl">{event.data.title}</h3>
              <p class="mt-1 text-sm text-muted">
                {describeWhen(event)}
                {event.data.location && <> &middot; {event.data.location}</>}
              </p>
            </div>
            {event.data.rsvp && (
              <a href={event.data.rsvp} class="shrink-0 text-sm text-brand hover:text-brand-deep">
                Sign up &rarr;
              </a>
            )}
          </li>
        ))}
      </ul>
    </>
  )}

  {planned.length > 0 && (
    <>
      <h2 class="mt-14 font-display text-3xl font-normal tracking-tight">Planned</h2>
      <p class="mt-3 max-w-[38em] text-body">
        Confirmed to happen. Dates are being finalized with the exec team — follow us on Discord to hear first.
      </p>
      <ul class="mt-6">
        {planned.map((event) => (
          <li class="border-t border-rule py-7 last:border-b">
            <div class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
              <div class="w-20 shrink-0 text-xs uppercase tracking-[0.09em] text-subtle">
                {event.data.window}
              </div>
              <div class="grow">
                <h3 class="font-display text-2xl">{event.data.title}</h3>
                {event.data.location && (
                  <p class="mt-1 text-sm text-muted">{event.data.location}</p>
                )}
                {event.body?.trim() && (
                  <p class="mt-3 max-w-[40em] leading-relaxed text-muted">{event.body.trim()}</p>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </>
  )}

  {past.length > 0 && (
    <>
      <h2 class="mt-14 font-display text-3xl font-normal tracking-tight">Past</h2>
      <ul class="mt-6 divide-y divide-rule border-t border-rule">
        {past.map((event) => (
          <li class="flex flex-wrap gap-x-6 gap-y-1 py-4 text-[15px]">
            <span class="grow">{event.data.title}</span>
            <span class="text-subtle">{fmt.longDate(event.data.date!)}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  {upcoming.length === 0 && planned.length === 0 && past.length === 0 && (
    <p class="mt-12 border-t border-rule pt-6 text-body">
      Nothing on the calendar yet — check back soon.
    </p>
  )}
</Base>
