---
import Base from '../layouts/Base.astro';
import { path } from '../lib/url';
import { AREAS, HERO_PHOTO } from '../lib/chapter';
import { groupEvents, fmt, describeWhen } from '../lib/events';
import { hasPublicFile } from '../lib/assets';

// Save the official ACM logo to public/acm-logo.png and it renders itself.
const ACM_LOGO = '/acm-logo.png';
const showLogo = hasPublicFile(ACM_LOGO);

const { upcoming, planned } = await groupEvents();

// One list, one treatment. Dated events first, then the ones still TBD --
// mixing two different card styles was what made this section feel ragged.
const agenda = [...upcoming, ...planned].slice(0, 4);
---

<Base
  title="Home"
  description="The only computing club at Samford University — AI, cybersecurity, software engineering and computer engineering, open to every major."
>
  <section class="grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">
        Samford University Student Chapter
      </p>
      <h1 class="mt-5 font-display text-5xl font-normal leading-[1.04] tracking-tight text-pretty sm:text-6xl">
        The only computing club<br class="hidden sm:inline" /> at <em class="italic text-brand">Samford</em>.
      </h1>
      <p class="mt-6 max-w-[31em] text-lg leading-relaxed text-body">
        Welcome to the Samford ACM chapter. Technology and computing are the
        future of our generation, and we are focused on securing that future.
        Everything from AI to cybersecurity to software engineering lives in
        this student chapter.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-6">
        <a
          href={path('/join')}
          class="bg-brand px-7 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
        >Join the chapter</a>
        <a
          href={path('/events')}
          class="border-b border-rule pb-0.5 text-[15px] text-body transition-colors hover:text-ink"
        >See upcoming events</a>
      </div>
    </div>

    <aside class="flex flex-col justify-end gap-6 lg:col-span-5 lg:border-l lg:border-rule lg:pl-10">
      {showLogo && (
        <img
          src={path(ACM_LOGO)}
          alt="Association for Computing Machinery"
          width="540"
          height="187"
          class="h-auto w-full max-w-[240px] self-start"
          loading="eager"
        />
      )}

      {HERO_PHOTO ? (
        <img
          src={path(HERO_PHOTO)}
          alt="Samford ACM members at a chapter event"
          class="aspect-[4/3] w-full object-cover"
          loading="eager"
        />
      ) : (
        <div
          class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-2 border border-dashed border-rule bg-white/60 text-subtle"
          aria-hidden="true"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="1"></rect>
            <circle cx="8.5" cy="10" r="1.5"></circle>
            <path d="M21 15l-5-5L5 19"></path>
          </svg>
          <span class="text-xs uppercase tracking-[0.09em]">Chapter photo coming soon</span>
        </div>
      )}

      <p class="font-display text-xl italic leading-normal text-ink">
        Open to every major. There is no coding test at the door.
      </p>
    </aside>
  </section>

  <section class="mt-16">
    <h2 class="text-xs uppercase tracking-[0.09em] text-subtle">What lives here</h2>
    <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {AREAS.map((area) => (
        <li class="flex items-center justify-center border border-rule px-4 py-4 text-center text-sm text-muted">
          {area}
        </li>
      ))}
    </ul>
  </section>

  <hr class="my-16 border-rule" />

  <section class="grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-3">
      <h2 class="font-display text-3xl font-normal tracking-tight">Upcoming events</h2>
      <a href={path('/events')} class="mt-3 inline-block text-sm text-brand hover:text-brand-deep">
        All events &rarr;
      </a>
    </div>

    <div class="lg:col-span-9">
      {agenda.length === 0 ? (
        <p class="border-t border-rule pt-6 text-body">
          Nothing on the calendar yet — check back soon.
        </p>
      ) : (
        <ul>
          {agenda.map((event) => (
            <li class="flex flex-wrap items-baseline gap-x-8 gap-y-2 border-t border-rule py-6 last:border-b">
              <div class="w-20 shrink-0">
                <div class="text-xs uppercase tracking-[0.09em] text-subtle">
                  {event.data.date ? fmt.month(event.data.date) : 'Date'}
                </div>
                <div
                  class:list={[
                    'font-display leading-none',
                    event.data.date ? 'text-3xl' : 'text-3xl text-subtle',
                  ]}
                >{event.data.date ? fmt.day(event.data.date) : 'TBD'}</div>
              </div>

              <div class="grow">
                <h3 class="font-display text-xl">{event.data.title}</h3>
                <p class="mt-1 text-sm text-muted">
                  {event.data.date && <>{describeWhen(event)}</>}
                  {event.data.date && event.data.location && <> &middot; </>}
                  {event.data.location}
                </p>
              </div>

              {event.data.rsvp && (
                <a href={event.data.rsvp} class="shrink-0 text-sm text-brand hover:text-brand-deep">
                  Sign up
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="mt-16 grid gap-12 sm:grid-cols-3 sm:gap-14">
    <div>
      <h3 class="font-display text-xl font-medium">Everything computing</h3>
      <p class="mt-2 leading-relaxed text-muted">
        Samford has one computing club, so this is where cybersecurity, software
        engineering and computer engineering all meet.
      </p>
    </div>
    <div>
      <h3 class="font-display text-xl font-medium">AI focused</h3>
      <p class="mt-2 leading-relaxed text-muted">
        A good idea plus AI now gets you further than a semester of coding used
        to. We spend real time on what that actually changes.
      </p>
    </div>
    <div>
      <h3 class="font-display text-xl font-medium">Competitions</h3>
      <p class="mt-2 leading-relaxed text-muted">
        We enter national competitions and host our own. No technical experience
        is required to take part.
      </p>
    </div>
  </section>

  <section class="mt-16 flex flex-wrap items-center gap-8 bg-ink px-10 py-14">
    <div class="grow">
      <h2 class="font-display text-3xl font-normal text-paper">
        There is a lot happening this year.
      </h2>
      <p class="mt-2 max-w-[34em] text-[15px] text-subtle">
        Hackathons, workshops and competitions, with events at least every other
        week — no dues, no prerequisites, no coding test.
      </p>
    </div>
    <a
      href={path('/join')}
      class="shrink-0 bg-brand px-8 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
    >Join the chapter</a>
  </section>
</Base>
