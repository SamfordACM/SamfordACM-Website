---
import Base from '../layouts/Base.astro';
import { path } from '../lib/url';
import { AREAS } from '../lib/chapter';
import { groupEvents, fmt } from '../lib/events';

const { upcoming, planned } = await groupEvents();
const nextUp = upcoming.slice(0, 3);
const bigThings = planned.slice(0, 3);
---

<Base
  title="Home"
  description="ACM is Samford University's computing club — AI, cybersecurity, software engineering, computer engineering, and business continuity, open to every major."
>
  <section class="grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">
        Samford University Student Chapter
      </p>
      <h1 class="mt-5 font-display text-5xl font-normal leading-[1.02] tracking-tight text-pretty sm:text-6xl lg:text-7xl">
        Build things you<br />didn't think you <em class="italic text-brand">could</em>.
      </h1>
      <p class="mt-6 max-w-[30em] text-lg leading-relaxed text-body">
        ACM is the computing club at Samford — the only one. Whatever corner of
        computing you are curious about, it lives here. We are especially
        interested in what AI makes possible when you have a good idea and not
        much code.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-6">
        <a
          href={path('/join')}
          class="bg-brand px-7 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
        >Join the chapter</a>
        <a
          href={path('/events')}
          class="border-b border-rule pb-0.5 text-[15px] text-body transition-colors hover:text-ink"
        >What we're building</a>
      </div>
    </div>

    <aside class="flex flex-col justify-end gap-5 lg:col-span-5 lg:border-l lg:border-rule lg:pl-10">
      <p class="font-display text-xl italic leading-normal text-ink">
        Open to every major. There is no coding test at the door.
      </p>
      <div class="border-t border-rule pt-5">
        <h2 class="text-xs uppercase tracking-[0.09em] text-subtle">What lives here</h2>
        <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-2">
          {AREAS.map((area) => (
            <li class="border border-rule px-3 py-1.5 text-sm text-muted">{area}</li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  <hr class="my-16 border-rule" />

  <section class="grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-3">
      <h2 class="font-display text-3xl font-normal tracking-tight">This year</h2>
      <a href={path('/events')} class="mt-3 inline-block text-sm text-brand hover:text-brand-deep">
        All events &rarr;
      </a>
    </div>

    <div class="lg:col-span-9">
      {nextUp.length > 0 && (
        <ul class="mb-10">
          {nextUp.map((event) => (
            <li class="flex flex-wrap items-baseline gap-x-8 gap-y-2 border-t border-rule py-6 last:border-b">
              <div class="w-20 shrink-0">
                <div class="text-xs uppercase tracking-[0.09em] text-subtle">
                  {fmt.month.format(event.data.date!)}
                </div>
                <div class="font-display text-3xl leading-none">
                  {fmt.day.format(event.data.date!)}
                </div>
              </div>
              <div class="grow">
                <h3 class="font-display text-xl">{event.data.title}</h3>
                <p class="mt-1 text-sm text-muted">
                  {fmt.time.format(event.data.date!)}
                  {event.data.location && <> &middot; {event.data.location}</>}
                </p>
              </div>
              {event.data.rsvp && (
                <a href={event.data.rsvp} class="shrink-0 text-sm text-brand hover:text-brand-deep">
                  Sign up
                </a>
              )}
            </li>
          ))}
        </ul>
      )}

      {bigThings.length > 0 && (
        <ul class="grid gap-px bg-rule sm:grid-cols-3">
          {bigThings.map((event) => (
            <li class="bg-paper py-6 sm:px-5 sm:first:pl-0">
              <p class="text-xs uppercase tracking-[0.09em] text-subtle">
                {event.data.window}
              </p>
              <h3 class="mt-2 font-display text-xl leading-snug">{event.data.title}</h3>
            </li>
          ))}
        </ul>
      )}

      {nextUp.length === 0 && bigThings.length === 0 && (
        <p class="border-t border-rule pt-6 text-body">
          Nothing on the calendar yet — check back soon.
        </p>
      )}
    </div>
  </section>

  <section class="mt-16 grid gap-12 sm:grid-cols-3 sm:gap-14">
    <div>
      <h3 class="font-display text-xl font-medium">Everything computing</h3>
      <p class="mt-2 leading-relaxed text-muted">
        Samford has one computing club, so this is where cybersecurity, software
        engineering, computer engineering and business continuity all meet.
      </p>
    </div>
    <div>
      <h3 class="font-display text-xl font-medium">AI, seriously</h3>
      <p class="mt-2 leading-relaxed text-muted">
        A good idea plus AI now gets you further than a semester of coding used
        to. We spend real time on what that actually changes.
      </p>
    </div>
    <div>
      <h3 class="font-display text-xl font-medium">Competitions</h3>
      <p class="mt-2 leading-relaxed text-muted">
        We enter hackathons, and this year we are hosting our own — plus a
        software engineering contest here at Samford.
      </p>
    </div>
  </section>

  <section class="mt-16 flex flex-wrap items-center gap-8 bg-ink px-10 py-14">
    <div class="grow">
      <h2 class="font-display text-3xl font-normal text-paper">
        This is the year we build it.
      </h2>
      <p class="mt-2 max-w-[34em] text-[15px] text-subtle">
        The chapter is being rebuilt from the ground up. Getting in now means
        shaping what it becomes — no dues, no prerequisites.
      </p>
    </div>
    <a
      href={path('/join')}
      class="shrink-0 bg-brand px-8 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
    >Join the chapter</a>
  </section>
</Base>
