---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { path } from '../lib/url';

const now = new Date();
const upcoming = (await getCollection('events'))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const month = new Intl.DateTimeFormat('en-US', { month: 'short' });
const day = new Intl.DateTimeFormat('en-US', { day: '2-digit' });
const time = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });

const doing = [
  {
    title: 'Workshops',
    body: 'Git, the terminal, deploying something real — the tooling coursework assumes you already know.',
  },
  {
    title: 'Project nights',
    body: 'Open room, open laptops. Hackathon teams form here most semesters.',
  },
  {
    title: 'Industry nights',
    body: 'Alumni and Birmingham engineers on what the job is actually like.',
  },
];
---

<Base title="Home">
  <section class="grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">
        Samford University Student Chapter
      </p>
      <h1 class="mt-5 font-display text-5xl font-normal leading-[1.02] tracking-tight text-pretty sm:text-6xl lg:text-7xl">
        A place to build<br />things that <em class="italic text-brand">work</em>.
      </h1>
      <p class="mt-6 max-w-[27em] text-lg leading-relaxed text-body">
        The Samford chapter of the Association for Computing Machinery. Weekly
        meetings, real projects, and a room full of people happy to help you get
        unstuck.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-6">
        <a
          href={path('/join')}
          class="bg-brand px-7 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
        >Join the chapter</a>
        <a
          href={path('/events')}
          class="border-b border-rule pb-0.5 text-[15px] text-body transition-colors hover:text-ink"
        >See what we're up to</a>
      </div>
    </div>

    <aside class="flex flex-col justify-end gap-5 lg:col-span-5 lg:border-l lg:border-rule lg:pl-10">
      <p class="font-display text-xl italic leading-normal text-ink">
        Open to every major. There is no coding test at the door.
      </p>
      <dl class="flex gap-10 border-t border-rule pt-5">
        <div>
          <dd class="font-display text-3xl text-brand">Weekly</dd>
          <dt class="mt-1 text-xs uppercase tracking-[0.09em] text-subtle">Meetings</dt>
        </div>
        <div>
          <dd class="font-display text-3xl text-brand">All</dd>
          <dt class="mt-1 text-xs uppercase tracking-[0.09em] text-subtle">Majors</dt>
        </div>
      </dl>
    </aside>
  </section>

  <hr class="my-16 border-rule" />

  <section class="grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-3">
      <h2 class="font-display text-3xl font-normal tracking-tight">Upcoming</h2>
      <a href={path('/events')} class="mt-3 inline-block text-sm text-brand hover:text-brand-deep">
        All events &rarr;
      </a>
    </div>

    <div class="lg:col-span-9">
      {upcoming.length === 0 ? (
        <p class="border-t border-rule pt-6 text-body">
          Nothing on the calendar right now — check back soon.
        </p>
      ) : (
        <ul>
          {upcoming.map((event, i) => (
            <li
              class:list={[
                'flex flex-wrap items-baseline gap-x-8 gap-y-2 border-t border-rule py-6',
                i === upcoming.length - 1 && 'border-b',
              ]}
            >
              <div class="w-20 shrink-0">
                <div class="text-xs uppercase tracking-[0.09em] text-subtle">
                  {month.format(event.data.date)}
                </div>
                <div class="font-display text-3xl leading-none">
                  {day.format(event.data.date)}
                </div>
              </div>
              <div class="grow">
                <h3 class="font-display text-xl">{event.data.title}</h3>
                <p class="mt-1 text-sm text-muted">
                  {time.format(event.data.date)} &middot; {event.data.location}
                </p>
              </div>
              {event.data.rsvp && (
                <a
                  href={event.data.rsvp}
                  class="shrink-0 text-sm text-brand hover:text-brand-deep"
                >RSVP</a>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="mt-16 grid gap-12 sm:grid-cols-3 sm:gap-14">
    {doing.map((item) => (
      <div>
        <h3 class="font-display text-xl font-medium">{item.title}</h3>
        <p class="mt-2 leading-relaxed text-muted">{item.body}</p>
      </div>
    ))}
  </section>

  <section class="mt-16 flex flex-wrap items-center gap-8 bg-ink px-10 py-14">
    <div class="grow">
      <h2 class="font-display text-3xl font-normal text-paper">
        Meetings are open. Come to one.
      </h2>
      <p class="mt-2 text-[15px] text-subtle">
        No membership required to show up and see what it's like.
      </p>
    </div>
    <a
      href={path('/join')}
      class="shrink-0 bg-brand px-8 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
    >Join the chapter</a>
  </section>
</Base>
