---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { path } from '../lib/url';

// Paste the Google Form embed URL here (Send > <> > copy the src value) and the
// form renders inline. Until then the page shows a fallback, not a dead iframe.
const SIGNUP_FORM_EMBED_URL: string | null = null;

const steps = [
  {
    title: 'Tell us you are interested',
    body: 'Fill out the form below so we can add you to the mailing list and let you know when we meet.',
  },
  {
    title: 'Come to a meeting',
    body: 'Show up to any meeting on the calendar. Nothing to sign, nothing to pay at the door.',
  },
  {
    title: 'Register with national ACM',
    body: 'Optional. A national membership adds journal and conference access on top of what the chapter does.',
  },
];
---

<Base title="Join">
  <PageHeader
    title="Join"
    lead="Membership is open to every Samford student, regardless of major or experience level. There is no coding test at the door."
  />

  <div class="mt-12 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">
        How to get involved
      </h2>
      <ol class="mt-6 space-y-7">
        {steps.map((step, i) => (
          <li class="flex gap-5">
            <span class="font-display text-2xl leading-none text-rule">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-display text-lg">{step.title}</h3>
              <p class="mt-1 leading-relaxed text-muted">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="lg:col-span-7">
      {SIGNUP_FORM_EMBED_URL ? (
        <iframe
          src={SIGNUP_FORM_EMBED_URL}
          title="Membership interest form"
          class="h-[900px] w-full border border-rule bg-white"
          loading="lazy"
        >Loading&hellip;</iframe>
      ) : (
        <div class="border border-dashed border-rule p-10 text-center">
          <p class="font-display text-xl">Interest form coming soon.</p>
          <p class="mx-auto mt-3 max-w-[26em] leading-relaxed text-muted">
            In the meantime, email us and we will add you to the list by hand.
          </p>
          <a
            href={path('/contact')}
            class="mt-6 inline-block bg-brand px-7 py-3 text-[15px] font-medium text-white transition-colors hover:bg-brand-deep"
          >Get in touch</a>
        </div>
      )}
    </div>
  </div>
</Base>
